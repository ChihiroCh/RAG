# ============ 阿里云百炼配置 ============
# 百炼控制台获取：https://bailian.console.aliyun.com/  ->  API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI 兼容模式地址（国际站可用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 模型配置（可自由替换为百炼上任意可用模型） ============
# 对话生成模型
LLM_MODEL=qwen4-max
LLM_FALLBACK_MODEL=
LLM_FALLBACK_MODELS=qwen-max,qwen-plus,qwen-flash
# 视觉理解模型（解析图片、扫描版 PDF）
# 若账号下没有 qwen3-vl-plus，可换成 qwen-vl-max / qwen-vl-max-latest / qwen3.5-omni-plus
VLM_MODEL=qwen3-vl-plus
VLM_FALLBACK_MODEL=
VLM_FALLBACK_MODELS=
OCR_MODEL=qwen-vl-ocr-2025-11-20
MODEL_UNAVAILABLE_TTL=600
# 向量模型
EMBED_MODEL=text-embedding-v3
# 向量维度（text-embedding-v3/v4 支持 1024/768/512，需与 EMBED_MODEL 匹配）
EMBED_DIM=1024
# 重排序模型
RERANK_MODEL=qwen3.7-text-rerank
# 若当前账号不支持上面的模型，可回退：RERANK_MODEL=gte-rerank-v2

# ============ 生成参数 ============
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ============ 检索参数 ============
# 向量召回候选数
TOP_K_VECTOR=20
# 精排后进入上下文的片段数
TOP_K_RERANK=5
# 上下文最大字符数
MAX_CONTEXT_CHARS=8000

# ============ 混合检索（向量 + BM25） ============
# BM25 词法召回（数值/科目名精确匹配），关闭则退回纯向量
BM25_ENABLED=true
# 向量/BM25 各自召回候选数
HYBRID_VECTOR_TOP_K=30
HYBRID_BM25_TOP_K=30
# RRF 融合后进入精排的候选数
HYBRID_FUSE_TOP_K=20
# RRF 平滑参数与 BM25 权重
RRF_K=60
BM25_WEIGHT=0.6
# 命中表格行块时回填父表（保证上下文有完整表头）
PARENT_EXPAND_ENABLED=true
# 同一文件最多进入上下文的表格数
RETRIEVAL_MAX_TABLE_PER_DOC=3

# ============ 查询改写 ============
# 规则改写（去噪声/同义归一），零成本
QUERY_REWRITE_ENABLED=true
# 是否额外调用大模型生成 2 条检索式（+1 次轻量调用，失败自动降级）
QUERY_REWRITE_LLM=true
QUERY_REWRITE_TIMEOUT=8

# ============ 结构化答案 ============
# number/json_array/json 题走强约束输出（只输出最终值，便于写提交文件）
NUMERIC_ANSWER_ENABLED=true

# ============ 分块参数 ============
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ============ 置信度（0-1） ============
# 总开关；关闭后不计算、不下发置信度
CONFIDENCE_ENABLED=true
# 是否在生成结束后调用大模型做"答案与资料一致性"校准（关闭则只用检索分）
CONFIDENCE_LLM_ENABLED=true
# 等级阈值：>= HIGH 为"高"，< LOW 为"低"（低分附带核实提醒）
CONFIDENCE_HIGH=0.85
CONFIDENCE_LOW=0.6
# 精排分归一化区间（qwen3.7-text-rerank 实测约 0.31~0.91；换回 gte-rerank-v2 时用 0.10/0.65）
CONFIDENCE_RERANK_LOW=0.30
CONFIDENCE_RERANK_HIGH=0.90
# 向量分归一化区间（精排不可用时降级使用）
CONFIDENCE_VECTOR_LOW=0.30
CONFIDENCE_VECTOR_HIGH=0.75
# 融合权重：最终分 = w*检索分 + (1-w)*一致性分
CONFIDENCE_RETRIEVAL_WEIGHT=0.55
# 一致性校准的超时（秒），超时自动降级为检索分
CONFIDENCE_TIMEOUT=8

# ============ 解析与索引 ============
# 视觉模型并发数（过高容易触发百炼限流）
VLM_CONCURRENCY=4
# 向量化批大小（text-embedding-v4 单次最多 10 条）
EMBED_BATCH_SIZE=10
# 源数据目录
FILES_DIR=files
# 索引与缓存目录
DATA_DIR=data
